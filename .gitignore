# ── Código-fonte — repositório privado ───────────────────────────────────────
CyberDyneWeb.py
recon_go/
Payloads_CY/
agentlog.md

# ── Segredos — NUNCA commitar ────────────────────────────────────────────────
.env
.env.local
.env.production
.env.staging
.env.example
*.pem
*.key
id_rsa
id_ed25519

# ── Go binários compilados ───────────────────────────────────────────────────
cyberdyne-recon
cyberdyne-recon.exe

# ── Resultados de scans ──────────────────────────────────────────────────────
Scans/*
!Scans/.gitkeep

# ── Docker (manter compose, esconder Dockerfiles de build) ───────────────────
Dockerfile
Dockerfile.full

# ── Workspace ────────────────────────────────────────────────────────────────
*.code-workspace

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
.tox/
.coverage
.pytest_cache/
*.egg-info/
dist/
build/
venv/
.venv/
env/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
